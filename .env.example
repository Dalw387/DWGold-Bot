# Port the Express server listens on (Railway sets PORT automatically)
PORT=3000

# Twilio credentials (optional for local /test, required for live WhatsApp)
# Find these in the Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Set to "true" to validate incoming Twilio webhook signatures on /whatsapp.
# Requires TWILIO_AUTH_TOKEN and a publicly reachable URL.
VALIDATE_TWILIO_SIGNATURE=false
