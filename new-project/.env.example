# Public site URL used in sitemap and Open Graph. Example: https://www.example.com
NEXT_PUBLIC_SITE_URL=

# Optional override. The live Payment Link is already baked into the app.
# https://buy.stripe.com/4gM14ndrHburaZpfZV48001
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Optional override. Site copy currently shows £197 one-off.
NEXT_PUBLIC_HOUSE_PRICE_LABEL=

# Only needed later if you switch from Payment Link to Checkout Sessions.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_HOUSE=
STRIPE_CHECKOUT_MODE=payment

# Owner email list. Set this, then open /owner/leads?key= the same value
OWNER_LEADS_KEY=

# Optional. New signups are also emailed here (defaults to nftdee@gmail.com)
LEADS_NOTIFY_EMAIL=

# Only needed for Apple Pay on a custom domain (not buy.stripe.com).
STRIPE_APPLE_PAY_DOMAIN_ASSOCIATION=
